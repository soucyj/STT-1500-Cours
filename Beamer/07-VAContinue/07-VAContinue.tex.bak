\frame{
	\frametitle{Lien entre densité et fonction de répartition}
	\begin{defn}{}
		Soit $X$ une variable aléatoire telle que pour tout sous-ensemble $B$ de $\mathbb{R}$ on ait
		\[\P{X\in B}=\int_B f(x)\,dx.\]
		On dira que $X$ est une v.a. (absolument) continue de \defi{densité de probabilité} $f(x)$.
	\end{defn}
	On a donc que
	$$F(x)=\P{X\leq x}=\P{X\in(-\infty,x]}=\int_{-\infty}^xf(u)du.$$ 
	En utilisant le théorème fondamental du calcul différentiel et intégral, on obtient aussi que
	$F'=f$.
}
\frame{
	\frametitle{Fonction de répartition sur $\R$}
	
	Une fonction $F:\R\rightarrow\R$ est appelée \defi{fonction de répartition} si elle satisfait les conditions ci-dessous:
	\begin{enumerate}
		\item Si $x<y$, alors $F(x)\leq F(y)$;\ 
		\item Pour tout $x\in\R$, $\lim_{\Delta x\rightarrow 0^+}F(x+\Delta x)=F(x)$;\ 
		\item $\lim_{x\rightarrow -\infty}F(x)=0$;\ 
		\item $\lim_{x\rightarrow \infty}F(x)=1$.\ 
	\end{enumerate}
}
\begin{frame}{Continuité vs continuité absolue}
	\begin{minipage}{0.45\textwidth}
		L'escalier de Cantor est un exemple d'une fonction continue monotone croissante de dérivée nulle presque partout (la dérivée n'est pas définie pour les $x\in\Q$). On ne peut pas l'écrire comme l'intégrale d'une fonction continue, elle n'est donc pas absolument continue. La fonction illustrée ci-contre est un exemple de fonction de répartition continue qui n'est pas absolument continue. Comme ces cas sont plutôt rares en pratique, nous ne distinguerons pas ces types de continuité.
	\end{minipage}
	\hfill
	\begin{minipage}{0.45\textwidth}
		\begin{center}
			\includegraphics[width=6cm]{images/Cantor.pdf}
			Escalier de Cantor (voir \cite{CantorEscalier})
		\end{center}
	\end{minipage}
\end{frame}
\section[Espérance]{Espérance d'une v.a. abs. continue}

\frame{
	\frametitle{Espérance d'une v.a. absolument continue}
	
	\begin{block}{Définition}
		Soit $X$ une v.a. avec densité $f(x)$. Si
		$$\int_{-\infty}^{\infty}|x|f(x)dx<\infty,$$
		\defi{l'espérance} de $X$ est définie par
		$$\Es{X}=\int_{-\infty}^{\infty}xf(x)dx.$$
	\end{block}
	
	\textbf{Remarques}\\
	On écrit souvent que $\mu_X=\Es{X}$, et on appelle parfois \defi{moyenne} l'espérance.\\
	
	
}
\section{Deux distributions}
\frame{
	\frametitle{La loi uniforme}
	
	\begin{block}{Définition}
		On dira qu'une v.a. $X$ suit une \defi{loi uniforme} sur l'intervalle ouvert $(a,b)$, si sa densité de probabilité est donnée par
		$$f(x)=\begin{cases}
			\frac{1}{b-a}&\text{si~}a<x<b,\\
			0 &\text{sinon.}\\
		\end{cases}$$
		On écrira alors que
		$$X\sim\loiuniforme{a}{b}.$$
	\end{block}
	On trouve facilement que si $X\sim\loiuniforme{a}{b}$, alors $\Es{X}=\frac{a+b}{2}.$
}

\frame{
	\frametitle{La loi exponentielle}
	
	\begin{block}{Définition}
		Soit $\lambda>0$. On dira qu'une v.a. $X$ suit une \defi{loi exponentielle} de paramètre $\lambda$ si sa densité de probabilité est donnée par
		$$f(x)=\begin{cases}
			\lambda\text{e}^{-\lambda x}&\text{si~}x>0,\\
			0 &\text{sinon.}\\
		\end{cases}$$
		On écrira alors que
		$$X\sim\loiexponentielle{\lambda}.$$
	\end{block}
	On trouve facilement que si $X\sim\loiexponentielle{\lambda}$, alors
	$$\Es{X}=\frac{1}{\lambda}.$$
}



\section[Fonction d'une v.a.]{Fonction d'une variable aléatoire}
\frame{
	\frametitle{Motivation - Fonction d'une v.a.}
	Soit $X$ une variable aléatoire suivant une loi uniforme sur l'intervalle $(0,1)$. Quelle est la distribution de la variable aléatoire $Y$ correspondant à $X^2$ ? Plus généralement, si $X$ est une variable aléatoire, quelle sera la distribution de la variable aléatoire $Y$ définie par $Y=g(X)$, où $g$ est une fonction réelle d'une variable réelle?
}
\frame{
	\frametitle{Cas discret}
	Soit $X$ une v.a. discrète dont la fonction de masse est $p_X(x)$. On veut trouver $p_Y(y)$, la fonction de masse de la variable aléatoire $Y$ définie par $Y=g(X)$. Pour y arriver, on:
	\begin{enumerate}
		\item détermine l'ensemble des valeurs possibles pour $Y$;
		\item calcule, pour chaque valeur possible $y$, la probabilité $p_Y(y)$ en remarquant que 
		\begin{align*}
			p_Y(y)&=\P{Y=y}\\
			&=\P{g(X)=y}\\
			&=\P{X\in\{x\in\R:g(x)=y\}}\\
			&=\sum_{\{x\in\R:g(x)=y\}}p_{X}(x).\
		\end{align*}
		Pour obtenir la fonction de répartition de $Y$, on remarque que $F_{Y}(y)=\sum_{u\in(-\infty,y]}p_{Y}(u)$.
	\end{enumerate}
}
\frame{
	\frametitle{Cas absolument continu}
	Soit $X$ une v.a. absolument continue dont la densité de probabilité est $f_X(x)$, et la fonction de répartition est $F_X(x)$. On veut trouver $f_Y(y)$, la densité de probabilité de la variable aléatoire $Y$ définie par $Y=g(X)$. Pour y arriver, on
	\begin{enumerate}
		\item détermine l'ensemble des valeurs possibles pour $Y$;
		\item calcule la fonction de répartition $F_Y(y)$ en observant que 
		\begin{align*}
			F_Y(y)&=\P{Y\leq y}\\
			&=\P{g(X)\leq y}\\
			&=\P{X\in\{x\in\R:g(x)\leq y\}}\\
			&=\int_{\{x\in\R:g(x)\leq y\}}f_{X}(x)dx;\
		\end{align*}
		\item dérive la fonction $F_Y(y)$ par rapport à $y$ pour obtenir $f_Y(y)$.\
	\end{enumerate}
}
\frame{
	\frametitle{Deux cas fréquent}
	Soit $X$ une v.a. absolument continu dont la densité de probabilité est $f_X(x)$. Supposons que l'ensemble des valeurs de $x$ telles que $f_X(x)>0$ est un intervalle ouvert $I$. Supposons que $Y=g(X)$, où $g$ est une fonction strictement croissante sur I, avec dérivée strictement positive partout sur $I$, ou bien strictement décroissante sur $I$, avec dérivée strictement négative sur $I$. Appelons $J$ l'image de $I$ par $g$. Alors la densité de $Y$ est donnée par
	
	$$f_Y(y)=\begin{cases}f_X\left(g^{-1}(y)\right)\left|\frac{d}{dy}g^{-1}(y)\right|&\text{si~} y\in J;\\
		0 &\text{sinon}.\\
	\end{cases}$$
}
\section{Simulation}
\frame{
	\frametitle{Cas discret}
	Faisons l'hypothèse que nous avons la possibilité de générer un nombre aléatoire dans l'intervalle $(0,1)$.\\
	
	On veut simuler, par exemple, une variable aléatoire dont la fonction de masse est $p(x)$. On suppose que $p(x)$ prend des valeurs positives seulement pour $x_1,x_2,\ldots$. L'idée est de partitionner l'intervalle $(0,1)$ de telle sorte que pour chaque intervalle $I_j$ de la partition choisie, nous avons que $p(x_j)=\text{longueur de l'intervalle~}I_j$.\\
	
	Si $U\sim\text{uniforme}\,(0,1)$, alors
	\[\P{X=x_j}=\P{U\in I_j}=p(x_j).\]
}
\frame{
	\frametitle{Cas absolument continu}
	Faisons à nouveau l'hypothèse que nous avons la possibilité de générer un nombre aléatoire dans l'intervalle $(0,1)$. C'est donc dire qu'on peut simuler la variable aléatoire $U$, où  $U\sim\loiuniforme{0}{1}$.\\
	
	On veut simuler une variable aléatoire $X$ dont la fonction de densité est $f(x)$ et la fonction de répartition $F(x)$. On fait l'hypothèse supplémentaire que $F$ est strictement croissante sur un intervalle $I$ vérifiant $F(I)=(0,1)$. Ce n'est pas une hypothèse trop exigeante. Il existe donc une fonction $F^{-1}:(0,1)\rightarrow I$ qui est une bijection. Définissons la variable aléatoire $Y=F^{-1}(U)$. Nous avons que
	\begin{align*}
		\P{Y\leq y}&=\P{F^{-1}(U)\leq y}\\
		&=\P{U\leq F(y)}\qquad (F \text{~est strictement croissante)}\\
		&=\frac{\text{longueur de l'intervalle~}(0,F(y))}{\text{longueur de l'intervalle~}(0,1)}\\
		&=F(y).\\
	\end{align*}
	
}
\begin{frame}[t]{Fonction quantile}
	\begin{defn}{}
		Soit $X$ une v.a. de fonction de répartition continue $F$. La fonction inverse de $F$ se nomme la \defi{fonction quantile} de $X$.
	\end{defn}
	Si on souhaite déterminer la médiane de $X$, il suffit de calculer $F^{-1}(\num{0,5})$. De même, si on souhaite trouver le premier quartile, on peut calculer $F^{-1}(\num{0,25})$.
\end{frame}
\section{Conditionnement}
\frame{
	\frametitle{Cas discret}
	Soit $E_1$, $E_2,\ldots E_n$ des ensembles qui forment une partition de $\Omega$, l'ensemble fondamental d'une expérience aléatoire. D'après la loi des probabilités totales, nous avons que
	\[\P{A}=\sum_{i=1}^n\P{A|E_i}\P{E_i}.\]
	Imaginons maintenant une variables aléatoire $X$ telle que $X=x_i\iff E_i$ se réalise. On peut donc écrire que
	\[\P{A}=\sum_{i=1}^n\P{A|X=x_i}\P{X=x_i}.\]
}
\frame{
	\frametitle{Cas absolument continu}
	Soit $X$ une variable aléatoire dont la densité de probabilité est $f_X(x)$. Supposons qu'on souhaite calculer la probabilité qu'un événement $A$ se réalise, et que la probabilité de réalisation de $A$ est affectée par la valeur que prend la variable aléatoire $X$. Faisons l'hypothèse que $\P{A|X=x}$ est une fonction de $x$ connue, où facilement calculable. Alors
	\[\P{A}=\int_{\R}\P{A|X=x}f_X(x)dx.\]
	Notons que l'expression \(\P{A|X=x}\) ne correspond pas à la définition du chapitre 3, puisque l'événement $\{X=x\}$ est de probabilité nulle.
}
